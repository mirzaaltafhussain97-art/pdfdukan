# Resend API key — Is se aapki website secure tareeqe se emails bhejegi
RESEND_API_KEY=re_LBwFP4LL_MFnrAeH8AjNBD9euG7DJ51pi

# Outgoing emails ka address — Onboarding email for testing before DNS verification
RESEND_FROM_EMAIL=onboarding@resend.dev

# Email received karte waqt jo naam user ko dikhega
RESEND_FROM_NAME=PDFdukan

# Website ka local base URL (Testing ke liye)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# OTP code kitne minutes tak valid rahega (10 Minutes)
OTP_EXPIRY_MINUTES=10

# ── DEV/TEST ONLY ────────────────────────────────────────────────────────────
# Resend test mode (onboarding@resend.dev) sirf account-owner ke email par
# deliver karta hai. Jab tak domain verify nahi hota, OTP emails is address par
# bhej do taake kisi bhi typed email se flow test ho sake.
# IMPORTANT: Jab aap apna domain verify kar lein aur RESEND_FROM_EMAIL ko
# noreply@pdfdukan.com (verified domain) par set kar dein, to yeh line HATA dein
# (ya khaali chhod dein) — production mein OTP user ke apne email par jaayega.
RESEND_TEST_REDIRECT_TO=mirzaaltafhussain97@gmail.com
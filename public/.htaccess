# ============================================================
#  PERFORMANCE: compression + browser caching
#  All blocks are wrapped in <IfModule> so they no-op safely
#  if the module is unavailable on the host.
# ============================================================

# --- Gzip / Deflate compression -----------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/x-font-ttf font/ttf font/otf font/woff font/woff2
</IfModule>

# --- Brotli compression (used first when available) ---------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/xml application/rss+xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

# --- Browser caching (Expires headers) ----------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # JS/CSS carry a ?v= version string, so cache hard for 1 year
  ExpiresByType application/javascript      "access plus 1 year"
  ExpiresByType text/javascript             "access plus 1 year"
  ExpiresByType text/css                    "access plus 1 year"
  # Images / fonts
  ExpiresByType image/png                   "access plus 1 year"
  ExpiresByType image/jpeg                  "access plus 1 year"
  ExpiresByType image/gif                   "access plus 1 year"
  ExpiresByType image/webp                  "access plus 1 year"
  ExpiresByType image/svg+xml               "access plus 1 year"
  ExpiresByType image/x-icon                "access plus 1 year"
  ExpiresByType font/woff                   "access plus 1 year"
  ExpiresByType font/woff2                  "access plus 1 year"
  ExpiresByType font/ttf                    "access plus 1 year"
  # HTML: revalidate often so content updates show up
  ExpiresByType text/html                   "access plus 0 seconds"
</IfModule>

# --- Cache-Control headers ----------------------------------
<IfModule mod_headers.c>
  # Long-cache static, immutable, versioned assets
  <FilesMatch "\.(js|css|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Always revalidate HTML
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ============================================================

# /blog and /blog/ both resolve to the blog index page
Redirect 301 /blog /blog/index.html

# 301 redirects for retired duplicate blog URLs (canonical = the -guide versions).
# Hostinger serves /public files from its static layer, so next.config.js
# redirects never fire for files that exist — these rules cover that layer.
Redirect 301 /blog/going-paperless.html /blog/going-paperless-guide.html
Redirect 301 /blog/document-digitization-best-practices.html /blog/document-digitization-guide.html

# --- retired AI tools (API-dependent) -> tools hub ---
Redirect 301 /tools/ai-detector.html /tools.html
Redirect 301 /tools/ai-humanizer.html /tools.html
Redirect 301 /tools/ai-pdf-chat.html /tools.html
Redirect 301 /tools/ai-pdf-summarizer.html /tools.html
Redirect 301 /tools/ai-summarize.html /tools.html
Redirect 301 /tools/assignment-writer.html /tools.html
Redirect 301 /tools/cover-letter-generator.html /tools.html
Redirect 301 /tools/essay-writer.html /tools.html
Redirect 301 /tools/mcq-generator.html /tools.html
Redirect 301 /tools/notes-generator.html /tools.html
Redirect 301 /tools/research-summarizer.html /tools.html
Redirect 301 /tools/resume-analyzer.html /tools.html
